# Datadog MCP - local development credentials
#
# IMPORTANT: This file is ONLY for running the server directly on your
# machine during development (e.g. `uv run datadog-mcp` or the scripts in
# scripts/). It is NOT the supported way to configure the server for use
# with Cursor - for that, set these same variables in the "env" block of
# your Cursor mcp.json (see README.md). Never commit a real .env file.
#
# This application key is scoped exclusively for this MCP server and only
# has the following permissions. Do not widen its scopes without updating
# this project's tool list accordingly:
#   Read:  logs_read, metrics_read, dashboards_read, monitors_read, apm_read
#   Write: metrics_write, dashboards_write, monitors_write, monitors_downtime_write

DD_API_KEY=your-datadog-api-key-here
DD_APP_KEY=your-datadog-application-key-here

# Datadog site/region. Common values: datadoghq.com (US1, default), us3.datadoghq.com,
# us5.datadoghq.com, datadoghq.eu, ap1.datadoghq.com
DD_SITE=datadoghq.com
