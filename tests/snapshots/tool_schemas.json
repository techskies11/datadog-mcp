        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field to aggregate for non-count aggregations (e.g. \"@duration\")"
        },
        "query": {
          "description": "Search query using Datadog APM span search syntax",
          "type": "string"
        },
        "to_time": {
          "description": "End time - same accepted formats as from_time",
          "type": "string"
        }
      },
      "required": [
        "query",
        "from_time",
        "to_time",
        "group_by"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    }
  },
