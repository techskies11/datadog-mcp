{
  "aggregate_logs_by_field": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "default": "count",
          "description": "Aggregation function to apply within each group",
          "enum": [
            "count",
            "cardinality",
            "pc75",
            "pc90",
            "pc95",
            "pc99",
            "sum",
            "min",
            "max",
            "avg"
          ],
          "type": "string"
        },
        "from_time": {
          "description": "Start time - ISO 8601, relative date math (e.g. \"now-1h\"), or a\nmillisecond timestamp",
          "type": "string"
        },
        "group_by": {
          "description": "Field to group by (e.g. \"@airline_name\", \"service\", \"status\")",
          "type": "string"
        },
        "indexes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional list of index names to search"
        },
        "interval": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If set (e.g. \"5m\", \"1h\", \"1d\"), returns a timeseries per group\ninstead of a single scalar per group"
        },
        "limit": {
          "default": 10,
          "description": "Maximum number of groups to return (default: 10)",
          "type": "integer"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Metric field for aggregations other than count (e.g. \"@duration\" for avg)"
        },
        "query": {
          "description": "Search query using Datadog log search syntax",
          "type": "string"
        },
        "to_time": {
          "description": "End time - same accepted formats as from_time",
          "type": "string"
        }
      },
      "required": [
        "query",
        "from_time",
        "to_time",
        "group_by"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    }
  },
  "aggregate_spans": {
    "inputSchema": {
      "additionalProperties": false,
