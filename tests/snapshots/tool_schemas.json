  "create_alert_monitor": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "description": "Notification text with @mentions (e.g. \"@slack-alerts CPU high!\")",
          "type": "string"
        },
        "monitor_type": {
          "description": "One of \"metric alert\", \"service check\", \"event alert\", \"query alert\",\n\"composite\", \"log alert\", \"rum alert\", \"trace-analytics alert\"",
          "enum": [
            "metric alert",
            "service check",
            "event alert",
            "query alert",
            "composite",
            "log alert",
            "rum alert",
            "trace-analytics alert"
          ],
          "type": "string"
        },
        "name": {
          "description": "Monitor name (descriptive)",
          "type": "string"
        },
        "options": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Advanced settings (thresholds, evaluation_delay, notify_no_data, etc.)"
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-5 (1=P1/highest, 5=P5/lowest)"
        },
        "query": {
          "description": "Alert query (examples above)",
          "type": "string"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional tags (e.g. [\"team:backend\", \"severity:high\"])"
        }
      },
      "required": [
        "name",
        "monitor_type",
        "query",
        "message"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    }
  },
