  "schedule_downtime": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "display_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IANA timezone for displaying the schedule (e.g. \"America/New_York\")"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Same accepted formats as start; omit for an open-ended downtime\nthat must be ended later via update_downtime"
        },
        "message": {
          "description": "Reason for the downtime (shown in notifications)",
          "type": "string"
        },
        "monitor_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional single monitor ID to restrict this downtime to"
        },
        "monitor_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional monitor tags to restrict this downtime to\n(mutually exclusive with monitor_id)"
        },
        "mute_first_recovery_notification": {
          "default": false,
          "description": "If True, suppress the first recovery\nnotification after the downtime ends (default: False)",
          "type": "boolean"
        },
        "scope": {
          "description": "Scope to mute, as a tag query (e.g. \"env:staging\", \"team:backend\",\nor \"*\" for everything matching monitor_id/monitor_tags)",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "default": "now",
          "description": "ISO 8601, relative date math (e.g. \"now\", \"now+1h\"), or a Unix\ntimestamp (default: \"now\")"
        }
      },
      "required": [
        "scope",
        "message"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    }
  },
